# shared-memory embedding configuration.
#
# Copy to `embedding.env` and edit as needed. All keys are optional: with no
# file present, shared-memory runs fully local with the defaults below.
#
# Data never leaves this host unless you switch EMBEDDING_PROVIDER to
# `openai_compatible` or `voyage` and fill in the credentials at the bottom.

# --- Storage backend ----------------------------------------------------------
# sqlite (default): one file with chunks, full-text index and vectors.
# chroma: the 0.1.x ChromaDB directory; needs `pip install "shared-memory[chroma]"`.
# SHARED_MEMORY_BACKEND=sqlite
# SHARED_MEMORY_DB=./memory.sqlite
# Minimum hybrid-search score for a type=similar link written by memory_add.
# Tag links ([[topic]]) do not use this cutoff.
# SHARED_MEMORY_LINK_THRESHOLD=0.75

# --- Local provider (default) -------------------------------------------------
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32
# EMBEDDING_DEVICE: cpu (default) or cuda/gpu. Mapped to ONNX providers for
# fastembed; ignored by the openai_compatible provider.
EMBEDDING_DEVICE=cpu
EMBEDDING_THREADS=1

# Collection name (Chroma); on SQLite it is shown in memory_stats only.
EMBEDDING_COLLECTION=shared_memory

# Optional task prefixes (some models, e.g. e5, expect "query: " / "passage: ").
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=

# Optional Matryoshka truncation: keep only the first N dims and re-normalize.
EMBEDDING_MATRYOSHKA_DIM=

# --- Remote provider (optional, OpenAI-compatible /v1/embeddings) -------------
# Uncomment and fill in to route embeddings through a remote API instead.
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_BASE_URL=https://your-endpoint.example.com/v1
# EMBEDDING_API_KEY=your-key-here
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536

# --- Voyage AI (optional) ------------------------------------------------------
# Query/document-aware embeddings. Changing provider or model means re-indexing:
# search ignores vectors produced by another model.
# EMBEDDING_PROVIDER=voyage
# EMBEDDING_MODEL=voyage-4
# EMBEDDING_API_KEY=pa-...        # or set VOYAGE_API_KEY in the environment
