# shared-memory embedding configuration.
#
# Copy to `embedding.env` and edit as needed. All keys are optional: with no
# file present, shared-memory runs fully local with the defaults below.
#
# Data never leaves this host unless you switch EMBEDDING_PROVIDER to
# `openai_compatible` and fill in the credentials at the bottom.

# --- Local provider (default) -------------------------------------------------
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu
EMBEDDING_THREADS=1

# Name of the Chroma collection to read/write.
EMBEDDING_COLLECTION=shared_memory

# Optional task prefixes (some models, e.g. e5, expect "query: " / "passage: ").
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOCUMENT_PREFIX=

# Optional Matryoshka truncation: keep only the first N dims and re-normalize.
EMBEDDING_MATRYOSHKA_DIM=

# --- Remote provider (optional, OpenAI-compatible /v1/embeddings) -------------
# Uncomment and fill in to route embeddings through a remote API instead.
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_BASE_URL=https://your-endpoint.example.com/v1
# EMBEDDING_API_KEY=your-key-here
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1536
